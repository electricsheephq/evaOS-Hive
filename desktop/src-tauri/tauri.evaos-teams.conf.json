      "../../LICENSE": "licenses/Buzz-Apache-2.0.txt",
      "evaos-teams/NOTICE.txt": "licenses/evaOS-Teams-NOTICE.txt"
    },
    "macOS": {
      "infoPlist": "evaos-teams/Info.plist",
      "dmg": {
        "background": "evaos-teams/dmg-background.png"
      }
    }
  }
}
