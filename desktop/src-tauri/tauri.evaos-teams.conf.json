{
  "productName": "evaOS Teams",
  "version": "0.4.23-es.1",
  "identifier": "com.electricsheephq.evaos.teams",
  "plugins": {
    "updater": {
      "endpoints": []
    },
    "deep-link": {
      "desktop": {
        "schemes": ["evaos-teams"]
      }
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false,
